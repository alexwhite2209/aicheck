# www.домен → основной домен (нужна A-запись www, иначе Caddy просто не выпустит для неё сертификат)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:3000 {
		# Caddy не доверяет входящим X-Forwarded-* от клиентов и выставляет реальный адрес сам
		header_up X-Real-IP {remote_host}
	}
}
