# Скопируйте в .env и заполните. Реальные ключи никогда не помещайте в Git.

# --- база данных и очередь (для docker compose заполняются автоматически из POSTGRES_*)
DATABASE_URL=
REDIS_URL=
POSTGRES_DB=norma
POSTGRES_USER=norma
POSTGRES_PASSWORD=

# --- AI (только backend; ключ не передаётся на фронтенд)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- проверка по реестрам (ЕГРЮЛ/ЕГРИП). Без ключа — ссылка на ручную проверку
DADATA_API_KEY=
# активные пробы безопасности (XSS/SQLi/IDOR) — только для подтверждённых доменов; в MVP выключено
SECURITY_ACTIVE_ENABLED=false

# --- оплата (если пусто — полный отчёт открыт всем, оплата скрыта)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- безопасность
JWT_SECRET=
IP_HASH_SECRET=

# --- адрес сайта (для ссылок, OpenGraph, возврата после оплаты)
NEXT_PUBLIC_API_URL=
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_PORT=3000
# HTTPS через Caddy (docker compose --profile https up -d)
DOMAIN=
TRUST_PROXY_HEADERS=false

# --- первый администратор (создаётся при старте backend). Вход на сайте — по логину и паролю
ADMIN_LOGIN=
ADMIN_PASSWORD=

# --- реквизиты оператора сервиса (политика, согласие, соглашение)
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# --- локальная разработка без Docker
# TASK_MODE=inline   # задачи в фоновых потоках backend (без Redis/Celery)
# ENV=development
